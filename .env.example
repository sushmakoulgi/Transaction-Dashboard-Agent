# Copy to .env and change the passwords. .env is git-ignored.

# --- Postgres (docker-compose) ---
POSTGRES_DB=transactions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
APP_OWNER_PASSWORD=change-me-owner
APP_READONLY_PASSWORD=change-me-readonly
POSTGRES_HOST_PORT=5432

# --- Database URLs used by tools and services running on the host ---
POSTGRES_DSN_OWNER=postgresql+psycopg://app_owner:change-me-owner@localhost:5432/transactions
POSTGRES_DSN_READONLY=postgresql+psycopg://app_readonly:change-me-readonly@localhost:5432/transactions

# --- Sample data ---
BUSINESS_TIMEZONE=America/New_York
SAMPLE_DATA_RANDOM_SEED=20261027

# --- Authentication (applies to every service) ---
# true (default): the Transaction Service API and the MCP server require bearer tokens.
# false: no token is checked and the tokens below may be left empty. Local testing only.
AUTH_ENABLED=true

# --- Transaction Service ---
# Shared by the Transaction Service and its callers (MCP server, agent). At least 16 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSACTION_SERVICE_API_TOKEN=change-me-to-a-long-random-token

# --- MCP server ---
# What MCP clients (the agent, Claude Desktop, ...) send as `Authorization: Bearer ...`.
MCP_API_TOKEN=change-me-to-another-long-random-token
TRANSACTION_SERVICE_URL=http://localhost:8200

# --- Agent service (Claude) ---
# Leave ANTHROPIC_API_KEY empty to let the SDK use ANTHROPIC_API_KEY from your shell
# environment or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Where the agent reaches the MCP server (it sends MCP_API_TOKEN while AUTH_ENABLED).
MCP_SERVER_URL=http://localhost:8100/mcp
PLANNER_MODEL=claude-opus-5-5
PLANNER_EFFORT=medium
USE_REFUSAL_FALLBACKS=true
# Session memory keeps only questions + their query plans (never results).
SESSION_CONTEXT_QUESTION_LIMIT=10
SESSION_IDLE_TTL_MINUTES=120
# Agent loop: Claude calls per question, and search rows Claude sees per tool result.
MAX_TOOL_ROUNDS=8
TOOL_RESULT_PREVIEW_ROWS=10

# --- Later phases (not used yet) ---
# VOYAGE_API_KEY=
