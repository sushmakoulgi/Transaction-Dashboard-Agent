# Copy to .env.local (git-ignored). Vite exposes VITE_* variables to the page.
VITE_AGENT_API_URL=http://localhost:8000
# Must match AGENT_API_TOKEN in the backend .env while AUTH_ENABLED=true; leave empty otherwise.
# It is bundled into the page, so this setup is for local, single-user use only.
VITE_AGENT_API_TOKEN=
